# ===== Deployment URL =====
NEXT_PUBLIC_DJANGO_URL=https://你的域名
DJANGO_INTERNAL_URL=http://127.0.0.1:8000
NEXT_APP_ORIGIN=https://你的域名

# ===== LLM API (supports any OpenAI-compatible endpoint) =====
LLM_API_KEY=sk-你的API密钥
# 兼容供应商示例中的 NEW_API_KEY；配置任意一个即可，NEW_API_KEY 优先。
NEW_API_KEY=
LLM_MODEL=gpt-5.4
LLM_BASE_URL=https://www.kudexapi.com/v1/chat/completions
# 用于加密数据库中的模型 API Key；生成后不得随意更换，否则需重新保存所有凭据。
# GENERATE WITH: openssl rand -hex 32
ECCP_CREDENTIAL_ENCRYPTION_KEY=替换为64位随机字符串
# 仅在已审核的企业内网模型网关场景设为 1。
ECCP_API_ALLOW_PRIVATE_MODEL_ENDPOINTS=0

# ===== Next.js <-> FastAPI internal auth =====
ECCP_API_INTERNAL_URL=http://127.0.0.1:8100
# GENERATE WITH: openssl rand -hex 32
ECCP_INTERNAL_AUTH_SECRET=替换为64位随机字符串
ECCP_API_INTERNAL_AUTH_SECRET=与上一行完全一致
# Automated topic discovery
ECCP_API_TOPIC_SEARCH_OPENSERP_URL=
ECCP_API_TOPIC_SEARCH_OPENSERP_API_KEY=
ECCP_API_TOPIC_SEARCH_OPENSERP_ENGINES=baidu,bing,duckduckgo
ECCP_API_TOPIC_SEARCH_SEARXNG_URL=
ECCP_API_TOPIC_SEARCH_SEARXNG_LANGUAGE=zh-CN
ECCP_API_TOPIC_SEARCH_RSS_FEEDS=
